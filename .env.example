# Copy to .env and fill in. Never commit .env.
LLM_BASE_URL=https://genailab.tcs.in
LLM_API_KEY=
LLM_MODEL_FAST=azure/genailab-maas-gpt-4.1-mini
LLM_MODEL_JUDGE=azure/genailab-maas-gpt-4.1
# system = Windows certificate store (corporate proxy) | default | off (last resort)
SSL_MODE=system
# Optional: fixed demo password (empty = any non-empty password works)
DEMO_PASSWORD=
# Review-time estimate assumptions (minutes per page)
MANUAL_MIN_PER_PAGE=4
ASSISTED_MIN_PER_PAGE=0.5
